# Neon serverless Postgres connection string.
# Get this from the Neon integration in your Vercel project, or from neon.tech directly.
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dbname?sslmode=require

# HMAC secret used to sign the participant cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-me-with-a-32-byte-hex-string

# Vercel Cron sends Authorization: Bearer <CRON_SECRET>. Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-a-32-byte-hex-string
